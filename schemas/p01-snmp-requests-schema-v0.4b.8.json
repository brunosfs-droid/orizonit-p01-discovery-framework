{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orizonit.example/schemas/p01-snmp-requests-v0.4b.8.json",
  "title": "Explicit SNMP endpoint requests v0.4b.8",
  "description": "Operator-declared endpoints. Each unique unicast IPv4 must match exactly one discovery seed and, when supplied, its authorized assessment manifest. No UDP observation is implied.",
  "type": "object",
  "required": ["schema_version", "endpoints"],
  "properties": {
    "schema_version": {"const": "0.4b.8"},
    "endpoints": {
      "type": "array", "minItems": 1, "maxItems": 25, "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["target_ip", "port", "profile_id"],
        "properties": {
          "target_ip": {"type": "string", "format": "ipv4"},
          "port": {"type": "integer", "minimum": 1, "maximum": 65535},
          "profile_id": {"type": "string", "minLength": 1, "pattern": "\\S"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
