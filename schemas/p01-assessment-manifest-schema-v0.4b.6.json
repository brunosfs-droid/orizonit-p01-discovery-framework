{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orizonit.example/schemas/p01-assessment-manifest-v0.4b.6.json",
  "title": "Orizon IT P01 Assessment Manifest v0.4b.6",
  "type": "object",
  "required": [
    "schema_version",
    "assessment_id",
    "authorized_scopes",
    "domains",
    "allowed_protocols",
    "safety_policy"
  ],
  "properties": {
    "schema_version": {
      "const": "0.4b.6"
    },
    "assessment_id": {
      "type": "string",
      "minLength": 1
    },
    "environment_label": {
      "type": "string"
    },
    "authorized_scopes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "exclude_scopes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "domains": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "dns_domain",
          "netbios_name",
          "scopes",
          "evidence_state"
        ],
        "properties": {
          "dns_domain": {
            "type": "string",
            "minLength": 1
          },
          "netbios_name": {
            "type": "string",
            "minLength": 1
          },
          "forest": {
            "type": [
              "string",
              "null"
            ]
          },
          "scopes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "evidence_state": {
            "const": "declared"
          }
        },
        "additionalProperties": false
      }
    },
    "discovery_nodes": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "allowed_protocols": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "safety_policy": {
      "type": "object",
      "required": [
        "default_concurrency",
        "max_actions",
        "require_authorized_ack",
        "auto_expand_scope"
      ],
      "properties": {
        "default_concurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "max_actions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "require_authorized_ack": {
          "type": "boolean"
        },
        "auto_expand_scope": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}