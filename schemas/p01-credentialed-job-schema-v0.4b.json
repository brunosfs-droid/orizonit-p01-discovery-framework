{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orizonit.example/schemas/p01-credentialed-job-v0.4b.json",
  "title": "P01 Credentialed Discovery Job v0.4b",
  "type": "object",
  "required": ["metadata", "source_plan", "summary", "actions", "credential_circuits", "limitations"],
  "properties": {
    "metadata": {
      "type": "object",
      "required": [
        "executor_name",
        "executor_version",
        "schema_version",
        "generated_at_utc",
        "run_label",
        "execution_host",
        "execution_mode",
        "read_only_mode",
        "secret_resolution",
        "authentication_attempts",
        "plan_sha256",
        "concurrency"
      ],
      "properties": {
        "executor_name": {"const": "P01-Credentialed-Discovery-Executor"},
        "executor_version": {"type": "string"},
        "schema_version": {"const": "0.4b"},
        "execution_mode": {"enum": ["dry_run", "execute"]},
        "read_only_mode": {"const": true},
        "secret_resolution": {"type": "boolean"},
        "authentication_attempts": {"type": "boolean"},
        "plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "concurrency": {"const": 1}
      },
      "additionalProperties": true
    },
    "source_plan": {"type": "object"},
    "summary": {"type": "object"},
    "actions": {"type": "array"},
    "credential_circuits": {"type": "object"},
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
