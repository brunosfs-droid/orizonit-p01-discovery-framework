{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orizonit.local/schemas/p01-snmp-enrichment-v0.4b.7.json",
  "title": "P01 SNMP single-target read-only enrichment v0.4b.7",
  "type": "object",
  "additionalProperties": false,
  "required": ["metadata", "target", "credential_policy", "authentication", "collection", "summary", "limits", "warnings"],
  "properties": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enricher_name", "enricher_version", "schema_version", "generated_at_utc", "execution_mode", "read_only_mode", "secret_values_persisted_to_output"],
      "properties": {
        "enricher_name": {"const": "P01-SNMP-Credentialed-Enrichment"},
        "enricher_version": {"const": "0.4b.7"},
        "schema_version": {"const": "0.4b.7"},
        "generated_at_utc": {"type": "string", "format": "date-time"},
        "execution_mode": {"enum": ["dry_run", "execute"]},
        "read_only_mode": {"const": true},
        "secret_values_persisted_to_output": {"const": false}
      }
    },
    "target": {
      "type": "object", "additionalProperties": false, "required": ["ip", "port", "transport"],
      "properties": {"ip": {"type": "string", "format": "ipv4"}, "port": {"type": "integer", "minimum": 1, "maximum": 65535}, "transport": {"const": "udp"}}
    },
    "credential_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["profile_id", "auth_type", "matched_scope", "attempt_limit", "same_profile_retries", "context_source"],
      "properties": {
        "profile_id": {"type": "string", "minLength": 1}, "auth_type": {"enum": ["snmpv2c", "snmpv3"]},
        "matched_scope": {"type": "string"}, "attempt_limit": {"const": 1}, "same_profile_retries": {"const": 0},
        "context_source": {"const": "operator_supplied"}
      }
    },
    "authentication": {
      "type": "object", "additionalProperties": false,
      "required": ["success", "result", "failure_category", "counts_against_credential_budget"],
      "properties": {
        "success": {"type": "boolean"},
        "result": {"enum": ["not_attempted", "secret_unavailable", "read_access_confirmed", "probe_failed"]},
        "failure_category": {"enum": [null, "configuration", "transport_or_silent_denial", "authentication_or_security", "remote_access_denied", "remote_or_invalid_response"]},
        "counts_against_credential_budget": {"const": false}
      }
    },
    "collection": {
      "type": "object", "additionalProperties": false, "required": ["status", "fields"],
      "properties": {
        "status": {"enum": ["not_attempted", "not_collected", "access_probe_only", "collected", "collected_with_field_failures"]},
        "fields": {
          "type": "array", "maxItems": 8,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["field", "oid", "status"],
            "properties": {
              "field": {"enum": ["sys_object_id", "sys_description", "sys_uptime_ticks", "sys_name", "sys_location", "sys_services", "interface_count", "ipv4_forwarding"]},
              "oid": {"type": "string", "pattern": "^1\\.3\\.6\\.1\\.2\\.1\\."},
              "status": {"enum": ["collected", "not_attempted", "not_available", "timeout", "deadline_exceeded", "access_denied", "remote_error", "security_error", "protocol_error", "invalid_response", "invalid_value", "oversized_value", "sensitive_value_omitted", "dependency_unavailable"]},
              "value": {"type": ["string", "integer"]}
            },
            "allOf": [{"if": {"properties": {"status": {"const": "collected"}}}, "then": {"required": ["value"]}, "else": {"not": {"required": ["value"]}}}]
          }
        }
      }
    },
    "summary": {
      "type": "object", "additionalProperties": false, "required": ["get_operations_attempted", "collected_fields"],
      "properties": {"get_operations_attempted": {"type": "integer", "minimum": 0, "maximum": 8}, "collected_fields": {"type": "integer", "minimum": 0, "maximum": 8}}
    },
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["max_get_operations", "operation_timeout_seconds", "deadline_seconds", "max_text_bytes"],
      "properties": {
        "max_get_operations": {"enum": [1, 8]}, "operation_timeout_seconds": {"type": "number", "minimum": 0.1, "maximum": 5},
        "deadline_seconds": {"type": "number", "minimum": 0.1, "maximum": 45}, "max_text_bytes": {"const": 1024}
      }
    },
    "warnings": {"type": "array", "maxItems": 1, "items": {"const": "snmpv2c_unencrypted_transport"}}
  }
}
