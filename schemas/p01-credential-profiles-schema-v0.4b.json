{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orizonit.example/schemas/p01-credential-profiles-v0.4b.json",
  "title": "Orizon IT P01 Credential Profiles v0.4b",
  "type": "object",
  "required": ["schema_version", "profiles"],
  "properties": {
    "schema_version": {"const": "0.4b"},
    "profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "protocol", "scopes", "secret_refs"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "enabled": {"type": "boolean"},
          "protocol": {"type": "string", "minLength": 1},
          "auth_type": {"type": ["string", "null"]},
          "scopes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "priority": {"type": "integer", "minimum": 0, "maximum": 10000},
          "username": {"type": ["string", "null"]},
          "secret_refs": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "string",
              "pattern": "^(env|prompt|wincred)://.+$"
            }
          },
          "max_attempts_per_target": {"type": "integer", "minimum": 1, "maximum": 3},
          "tags": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
