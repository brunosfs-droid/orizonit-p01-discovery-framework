{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orizonit.example/schemas/p01-credential-profiles-v0.4b.json",
  "title": "Orizon IT P01 Credential Profiles v0.4b",
  "type": "object",
  "required": [
    "schema_version",
    "profiles"
  ],
  "properties": {
    "schema_version": {
      "const": "0.4b"
    },
    "profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "protocol",
          "scopes",
          "secret_refs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "enabled": {
            "type": "boolean"
          },
          "protocol": {
            "type": "string",
            "minLength": 1
          },
          "auth_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "snmp_security": {
            "description": "SNMPv3 v0.4b.7 requires this exact authPriv policy; other adapters ignore it.",
            "const": {"level": "authPriv", "auth_protocol": "sha256", "privacy_protocol": "aes128"}
          },
          "scopes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "priority": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "username": {
            "type": [
              "string",
              "null"
            ]
          },
          "secret_refs": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "string",
              "pattern": "^(env|prompt|wincred)://.+$"
            }
          },
          "max_attempts_per_target": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "selectors": {
            "type": "object",
            "properties": {
              "device_types": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "os_families": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "services": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "hostname_patterns": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "vendor_patterns": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "realms": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "min_confidence": {
                "type": "string",
                "enum": [
                  "Unknown",
                  "Low",
                  "Medium",
                  "High",
                  "unknown",
                  "low",
                  "medium",
                  "high"
                ]
              },
              "allow_unknown": {
                "type": "boolean"
              },
              "target_classes": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "realm_kinds": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "min_realm_evidence": {
                "type": "string",
                "enum": [
                  "declared",
                  "observed",
                  "credentialed_confirmed"
                ]
              }
            },
            "additionalProperties": false
          },
          "failure_budget_per_job": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          },
          "realm_kind": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "ad_domain",
              "local_host",
              "linux_local",
              "vcenter_sso",
              "network_aaa",
              "device_local",
              "other",
              null
            ]
          },
          "realm_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "target_classes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": [
                "windows",
                "windows_server",
                "windows_workstation",
                "domain_controller",
                "linux",
                "vcenter",
                "esxi",
                "network_device",
                "switch",
                "router",
                "firewall",
                "storage",
                "appliance",
                "other"
              ]
            }
          },
          "privilege_class": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "read_only",
              "inventory",
              "operator",
              "local_admin",
              "domain_admin",
              "platform_admin",
              "network_admin",
              null
            ]
          },
          "purposes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": [
                "discovery",
                "inventory",
                "configuration_audit",
                "patch_assessment",
                "topology"
              ]
            }
          },
          "realm_evidence_min": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "declared",
              "observed",
              "credentialed_confirmed",
              null
            ]
          },
          "high_privilege_acknowledged": {
            "type": "boolean"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
